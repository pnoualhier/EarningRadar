{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EarningsCalendar",
  "type": "object",
  "required": ["metadata", "events"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schemaVersion", "generatedAt", "lastSuccessfulFetchAt", "provider", "status", "eventCount", "markets", "warnings"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "lastSuccessfulFetchAt": { "type": ["string", "null"], "format": "date-time" },
        "provider": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "partial", "stale", "unavailable"] },
        "eventCount": { "type": "integer", "minimum": 0 },
        "markets": {
          "type": "array",
          "items": { "type": "string", "enum": ["US", "EU"] }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "symbol", "companyName", "market", "announcementDate", "session", "dateStatus", "sourceName", "fetchedAt"],
        "properties": {
          "id": { "type": "string" },
          "symbol": { "type": "string" },
          "companyName": { "type": "string" },
          "market": { "type": "string", "enum": ["US", "EU"] },
          "exchange": { "type": "string" },
          "country": { "type": "string" },
          "announcementDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "announcementTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
          "timeZone": { "type": "string" },
          "session": { "type": "string", "enum": ["before_open", "after_close", "during_session", "unknown"] },
          "dateStatus": { "type": "string", "enum": ["confirmed", "estimated", "unverified"] },
          "fiscalPeriod": { "type": "string" },
          "epsEstimate": { "type": "number" },
          "epsActual": { "type": "number" },
          "revenueEstimate": { "type": "number" },
          "revenueActual": { "type": "number" },
          "currency": { "type": "string" },
          "sourceName": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "sourceUpdatedAt": { "type": "string" },
          "fetchedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
